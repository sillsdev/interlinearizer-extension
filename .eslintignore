# #region shared with https://github.com/paranext/paranext-multi-extension-template/blob/main/.eslintignore

# Please keep this file in sync with .prettierignore and .stylelintignore

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed

# Dependency directory
# https://www.npmjs.org/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git
node_modules

# OSX
.DS_Store

.idea
npm-debug.log.*
*.css.d.ts
*.sass.d.ts
*.scss.d.ts

# Built files
dist
release
temp-build

# Jest
__mocks__
coverage

# generated files
package-lock.json

# #endregion

# Playwright test output
e2e-tests/playwright-report
e2e-tests/test-results

# A verbatim copy of the template's manifest, kept byte-for-byte so refreshing it is a plain
# `git show` redirect rather than a copy plus whatever our tooling would impose on it
scripts/merged-template-package.json
