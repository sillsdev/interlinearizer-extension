<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Harmony ships for .NET 10 only. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Interlinearizer.Crdt</RootNamespace>
    <AssemblyName>InterlinearizerCrdt</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InterlinearizerCrdt.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="SIL.Harmony" Version="0.2.1-rc.445" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SIL.Harmony.Core" />
  </ItemGroup>

</Project>
